PORT=4000
# Postgres from docker-compose.yml (host port 5434)
DATABASE_URL=postgres://brasq:brasq@localhost:5434/brasq

# Public URL of this API (used to build image URLs for local storage)
PUBLIC_URL=http://localhost:4000
# Frontend origin(s) allowed by CORS, comma-separated
CORS_ORIGINS=http://localhost:3000

# Admin login
ADMIN_EMAIL=admin@brasq.com
ADMIN_PASSWORD=change-me
# Secret for signing admin JWTs
AUTH_SECRET=replace-with-a-long-random-string
# Static bearer token for automation (Claude, scripts, n8n...). Empty = disabled.
API_TOKEN=replace-with-another-long-random-string

# Image storage: "local" (./uploads folder) or "s3".
# Defaults to local in development and s3 when NODE_ENV=production.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# S3 (used when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=us-east-1
# Public base URL for objects: CloudFront domain or https://<bucket>.s3.<region>.amazonaws.com
S3_PUBLIC_URL=
S3_PREFIX=uploads/
# Leave empty to use the default AWS credential chain (IAM role, ~/.aws, ...)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
