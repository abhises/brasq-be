generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PostType {
  guide
  review
  page
  /// Two to four products side by side ("product x vs product y")
  comparison
  /// Explainers and how-tos that don't rank products
  informational
}

enum PostStatus {
  draft
  published
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  intro     String   @default("")
  sortOrder Int      @default(0)
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Author {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  role       String   @default("")
  short      String   @default("")
  bio        String   @default("")
  email      String?
  avatarUrl  String?
  /// [{ value, label }]
  facts      Json     @default("[]")
  /// ["Vacuums", ...]
  expertise  Json     @default("[]")
  /// [{ years, text }]
  career     Json     @default("[]")
  sortOrder  Int      @default(0)
  showOnHome Boolean  @default(true)
  posts      Post[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Post {
  id             String     @id @default(cuid())
  type           PostType   @default(guide)
  status         PostStatus @default(draft)
  slug           String
  title          String
  /// Short intro used on cards, search and as meta description fallback
  excerpt        String     @default("")
  /// The page body. Rendered as-is inside <main>.
  html           String     @default("")
  /// Extra CSS for this post only. Rendered in a <style> tag next to the HTML.
  css            String     @default("")
  coverImage     String?
  seoTitle       String?
  seoDescription String?
  /// Raw JSON-LD (structured data) for this page
  jsonLd         String?
  /// Card metadata (guides)
  testedCount    Int?
  testWeeks      Int?
  topPick        String?
  /// Sticky "our pick" bar shown while scrolling: { name, score, price, shop, url, image }
  stickyBar      Json?
  /// Section-based content: { layout: "toc" | "wide", items: [{ id, type, data, hidden? }] }.
  /// When set, `html` is rendered from it on save; when null the post is plain HTML.
  sections       Json?
  /// Unpublished edits to `sections` (used by the front page: edit, preview, then publish)
  draftSections  Json?
  newsletterPopup Boolean   @default(false)
  featured       Boolean    @default(false)
  categoryId     String?
  category       Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId       String?
  author         Author?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([type, slug])
  @@index([status, type])
}

model Media {
  id        String   @id @default(cuid())
  key       String   @unique
  url       String
  filename  String
  mimeType  String
  size      Int
  alt       String   @default("")
  driver    String
  createdAt DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())
}

/// A reusable block for posts and the front page: fields (form), an HTML template and CSS.
model SectionType {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  group       String   @default("Other")
  description String   @default("")
  /// [{ key, label, type, required?, help?, options?, fields? }]
  fields      Json     @default("[]")
  /// HTML with {{placeholders}}, {{#list}}…{{/list}} and {{^empty}}…{{/empty}}
  template    String   @default("")
  /// CSS for custom types; scoped to the section automatically. Built-in types use brasq.css.
  css         String   @default("")
  /// Sample field values for previews
  sample      Json     @default("{}")
  /// Table-of-contents label, a template like "{{heading}}"; empty = not in the TOC
  tocLabel    String   @default("")
  /// "body" (main column), "top" (full width above the columns) or "bottom" (full width below)
  placement   String   @default("body")
  /// "any", "post" or "home" (front page only)
  scope       String   @default("any")
  builtIn     Boolean  @default(false)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Shared product data used by section fields of type "product".
model Product {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  score      Float?
  price      Float?
  image      String?
  /// [{ name: "Amazon", url }]
  shops      Json     @default("[]")
  /// Slug of the product's review post, if any
  reviewSlug String?
  summary    String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
